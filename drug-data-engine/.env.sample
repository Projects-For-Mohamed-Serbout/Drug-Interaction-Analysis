# MongoDB Atlas Configuration
# Contact the project owner to get these credentials
MONGODB_URI=
MONGODB_DB=drug_interaction_analysis

# Neo4j Aura DB Configuration
# Contact the project owner to get these credentials
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Data Path (relative to project root)
DATA_PATH=data

# Secret Key (generate a random string for production)
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Environment
ENV=development
